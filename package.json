{
  "name": "money-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "icons": "node scripts/icons.mjs",
    "types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "push:test": "node scripts/push-test.mjs",
    "dev:cloud": "vite --mode cloud",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "^5.105.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-persist-client": "^5.105.3",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "vaul": "^1.1.2",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
